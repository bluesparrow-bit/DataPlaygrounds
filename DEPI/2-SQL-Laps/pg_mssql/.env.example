# Copy to .env and fill in. `.env` is git-ignored — never commit it.
#
#   cp .env.example .env
#   docker compose up -d

# --- SQL Server 2022 (requires: 8+ chars, upper, lower, digit, symbol) ---
MSSQL_SA_PASSWORD=

# --- PostgreSQL 16 ---
POSTGRES_USER=blue
POSTGRES_PASSWORD=
POSTGRES_DB=practice
